    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@klinecharts/pro": "^0.1.1",
    "klinecharts": "^9.8.12",
    "lightweight-charts": "^5.0.0",
    "trading-signals": "^8.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}

{
  "name": "dsh-trading-agent",
  "version": "0.1.0",
  "description": "DSH 插件：在右侧栏原生自定义 tab 中渲染加密行情技术分析图表",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "trading",
    "crypto",
    "technical-analysis",
    "lightweight-charts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnny-ggao/trading-agent.git"
  },
  "homepage": "https://github.com/johnny-ggao/trading-agent#readme",
  "bugs": {
    "url": "https://github.com/johnny-ggao/trading-agent/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false,
      "external": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@typesafe-ai/sdk": "^0.6.0",
    "lightweight-charts": "^5.0.0",
    "trading-signals": "^8.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}

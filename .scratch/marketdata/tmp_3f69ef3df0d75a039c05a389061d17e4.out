":"{\n  \"levels\": [\n    1.092360019683838,\n    1.1026300191879272,\n    1.113450050354004,\n    1.1233500242233276,\n    1.134719967842102,\n    1.1513700485229492\n  ]\n}","section":"Technical Analysis","security":[{"api_key":[]}],"summary":"Support/Resistance","tags":["Default"],"title":"Support/Resistance Levels API for Stocks, Forex, Crypto","urlId":"support-resistance","widget":null}},"/scan/technical-indicator":{"get":{"consumes":["application/json"],"description":"Get aggregate signal of multiple technical indicators such as MACD, RSI, Moving Average v.v. A full list of indicators can be found \u003ca href=\"https://docs.google.com/spreadsheets/d/1MWuy0WuT2yVlxr1KbPdggVygMZtJfunDnhe-C0GEXYM/edit?usp=sharing\" target=\"_blank\"\u003ehere\u003c/a\u003e.","examples":[{"text":"/scan/technical-indicator?symbol=AAPL\u0026resolution=D","url":"/scan/technical-indicator?symbol=AAPL\u0026resolution=D\u0026token=\u003ctoken\u003e"}],"freeTier":null,"highUsage":null,"navHeader":"Aggregate Indicators","newEndpoint":null,"operationId":"aggregate-indicator","parameters":[{"description":"symbol","in":"query","name":"symbol","required":true,"type":"string"},{"description":"Supported resolution includes \u003ccode\u003e1, 5, 15, 30, 60, D, W, M \u003c/code\u003e.Some timeframes might not be available depending on the exchange.","in":"query","name":"resolution","required":true,"type":"string"}],"premium":"Premium Access Required","produces":["application/json"],"responses":{"200":{"description":"successful operation","schema":{"$ref":"#/definitions/AggregateIndicators","type":"object"}}},"sampleCode":{"curl":"autoGenerated","go":"res, _, err := finnhubClient.AggregateIndicator(context.Background()).Symbol(\"AAPL\").Resolution(\"D\").Execute()","javascript":"finnhubClient.aggregateIndicator(\"AAPL\", \"D\", (error, data, response) =\u003e {\n  console.log(data)\n});","kotlin":"println(apiClient.aggregateIndicator(\"AAPL\", \"D\"))","php":"print_r($client-\u003eaggregateIndicator(\"AAPL\", \"D\"));","python":"print(finnhub_client.aggregate_indicator('AAPL', 'D'))","ruby":"puts(finnhub_client.aggregate_indicator('AAPL', 'D'))","useTemplate":true},"sampleResponse":"{\n  \"technicalAnalysis\": {\n    \"count\": {\n      \"buy\": 6,\n      \"neutral\": 7,\n      \"sell\": 4\n    },\n    \"signal\": \"neutral\"\n  },\n  \"trend\": {\n    \"adx\": 24.46020733373421,\n    \"trending\": false\n  }\n}","section":"Technical Analysis","security":[{"api_key":[]}],"summary":"Aggregate Indicators","tags":["Default"],"title":"Aggregate Indicators/Technical Signal API for Stocks, Forex, Crypto","urlId":"aggregate-indicator","widget":null}},"/search":{"get":{"consumes":["application/json"],"description":"Search for best-matching symbols based on your query. You can input anything from symbol, security's name to ISIN and Cusip.","examples":[{"text":"/search?q=apple\u0026exchange=US","url":"/search?q=apple\u0026exchange=US\u0026token=\u003ctoken\u003e"},{"text":"/search?q=US5949181045","url":"/search?q=US5949181045\u0026token=\u003ctoken\u003e"}],"freeTier":null,"highUsage":null,"navHeader":"Symbol Lookup","newEndpoint":null,"operationId":"symbol-search","parameters":[{"description":"Query text can be symbol, name, isin, or cusip.","in":"query","name":"q","required":true,"type":"string"},{"description":"Exchange limit.","in":"query","name":"exchange","required":false,"type":"string"}],"premium":null,"produces":["application/json"],"responses":{"200":{"description":"successful operation","schema":{"$ref":"#/definitions/SymbolLookup","type":"object"}}},"sampleCode":{"curl":"autoGenerated","go":"res, _, err := finnhubClient.SymbolSearch(context.Background()).Q(\"AAPL\").Execute()","javascript":"finnhubClient.symbolSearch('AAPL', (error, data, response) =\u003e {\n  console.log(data)\n});","kotlin":"println(apiClient.symbolSearch(\"AAPL\"))","php":"print_r($client-\u003esymbolSearch(\"AAPL\"));","python":"print(finnhub_client.symbol_lookup('apple'))","ruby":"
quire 'finnhub_ruby'\n\nFinnhubRuby.configure do |config|\n  config.api_key['api_key'] = '\u003ctoken\u003e'\nend\n\nfinnhub_client = FinnhubRuby::DefaultApi.new\n\u003cMY_CODE\u003e\n"},"schemes":["https"],"securityDefinitions":{"api_key":{"in":"query","name":"token","type":"apiKey"}},"swagger":"2.0"}

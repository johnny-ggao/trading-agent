hubClient.covid19((error, data, response) =\u003e {\n  console.log(data)\n});","kotlin":"println(apiClient.covid19())","php":"print_r($client-\u003ecovid19());","python":"print(finnhub_client.covid19())","ruby":"puts(finnhub_client.covid19())","useTemplate":true},"sampleResponse":"[\n  {\n    \"state\": \"New York\",\n    \"case\": 8403,\n    \"death\": 46,\n    \"updated\": \"2020-03-20 21:38:50\"\n  },\n  {\n    \"state\": \"Washington\",\n    \"case\": 1524,\n    \"death\": 83,\n    \"updated\": \"2020-03-20 21:38:50\"\n  }\n]","section":"Alternative Data","security":[{"api_key":[]}],"summary":"COVID-19","tags":["Default"],"title":"Real-time COVID-19 data API","urlId":"covid-19","widget":null}},"/crypto/candle":{"get":{"consumes":["application/json"],"description":"Get candlestick data for crypto symbols.","examples":[{"text":"/crypto/candle?symbol=BINANCE:BTCUSDT\u0026resolution=D\u0026from=1572651390\u0026to=1575243390","url":"/crypto/candle?symbol=BINANCE:BTCUSDT\u0026resolution=D\u0026from=1572651390\u0026to=1575243390\u0026token=\u003ctoken\u003e"}],"freeTier":null,"highUsage":null,"navHeader":"Candles","newEndpoint":null,"operationId":"crypto-candles","parameters":[{"description":"Use symbol returned in \u003ccode\u003e/crypto/symbol\u003c/code\u003e endpoint for this field.","in":"query","name":"symbol","required":true,"type":"string"},{"description":"Supported resolution includes \u003ccode\u003e1, 5, 15, 30, 60, D, W, M \u003c/code\u003e.Some timeframes might not be available depending on the exchange.","in":"query","name":"resolution","required":true,"type":"string"},{"description":"UNIX timestamp. Interval initial value.","format":"int64","in":"query","name":"from","required":true,"type":"integer"},{"description":"UNIX timestamp. Interval end value.","format":"int64","in":"query","name":"to","required":true,"type":"integer"}],"premium":"Premium Access Required","produces":["application/json"],"responses":{"200":{"description":"successful operation","sc